# Copy to .env in this directory. Never put credentials in the web app.
# MODEL_BASE_URL is an OpenAI-compatible API base ending with /v1 if required.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=35
# Optional: absolute path. Default is app/runtime/anxin.db.
ANXIN_DATABASE_PATH=
